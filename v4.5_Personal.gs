function e45Book_(){const ss=SpreadsheetApp.getActiveSpreadsheet();if(!ss)throw Error('Open this Apps Script project from the master estimator Google Sheet.');const configured=PropertiesService.getScriptProperties().getProperty('SPREADSHEET_ID');if(configured&&ss.getId()!==configured)throw Error('SPREADSHEET_ID points to a different file. No changes made.');return ss;}
function e45Rows_(ss,name){const sh=ss.getSheetByName(name);if(!sh)throw Error('Missing tab '+name);const h=E45.headers[name],header=sh.getRange(1,1,1,h.length).getValues()[0].map(String);if(h.some((x,i)=>header[i]!==x))throw Error('Header mismatch on '+name);const data=sh.getLastRow()>1?sh.getRange(2,1,sh.getLastRow()-1,h.length).getValues():[];return {sh,h,rows:data.map((arr,i)=>{const r={_row:i+2};h.forEach((k,j)=>r[k]=arr[j]);return r;}).filter(r=>h.some(k=>r[k]!==''&&r[k]!==null))};}
function e45Num_(x){if(x===''||x===null||x===undefined)return null;const n=Number(x);return Number.isFinite(n)?n:null;}
function e45Norm_(x){return String(x||'').toLowerCase().replace(/[^a-z0-9]+/g,' ').trim();}
function e45Unit_(x){const s=e45Norm_(x).replace(/ /g,'');const u={sf:'SF',sqft:'SF',lf:'LF',linearfoot:'LF',ea:'EA',each:'EA',hour:'HR',hours:'HR',hr:'HR',cy:'CY',sq:'SQ',bf:'BF',ton:'TON',day:'DAY',load:'LOAD'};return u[s]||String(x||'').toUpperCase().trim();}
function e45Round_(x){return Math.round((Number(x)+Number.EPSILON)*10000)/10000;}
function e45Settings_(ss){const a={};e45Rows_(ss,'Settings').rows.forEach(r=>a[String(r.Key)]=r.Value);return a;}

/** Non-destructive inspection. Does not install triggers or touch data. */
function previewV45Reset(){const ss=e45Book_();const out={spreadsheet:ss.getUrl(),tabs:ss.getSheets().map(s=>s.getName()),willDeleteOldTestData:true,requiredPersonalScriptProperty:'V45_RESET_CONFIRM=WIPE_TEST_DATA',keepsSpreadsheetID:true,keepsExistingScriptProperties:true};Logger.log(JSON.stringify(out));return out;}

/**
 * Deliberate reset of disposable TEST data in the existing spreadsheet ID.
 * Save V45_RESET_CONFIRM=WIPE_TEST_DATA in the PERSONAL Apps Script Properties.
 * Run repeatedly until progress reports phase COMPLETE. Deletes/creates at most TWO tabs/run.
 * Pause all billing triggers BEFORE starting. No backup copies made.
 */
function resetV45Master(){const ss=e45Book_(),p=PropertiesService.getScriptProperties();if(p.getProperty('V45_RESET_CONFIRM')!=='WIPE_TEST_DATA')throw Error('Set V45_RESET_CONFIRM=WIPE_TEST_DATA in personal script properties. This erases test data.');
 let phase=p.getProperty('V45_PHASE')||'DELETE',work=ss.getSheetByName('__V45_RESET__');if(!work)work=ss.insertSheet('__V45_RESET__');
 if(phase==='DELETE'){
   const old=ss.getSheets().filter(s=>s.getName()!=='__V45_RESET__');for(const sh of old.slice(0,2)){ss.deleteSheet(sh);}
   SpreadsheetApp.flush();const remain=ss.getSheets().filter(s=>s.getName()!=='__V45_RESET__').length;if(remain===0){phase='CREATE';p.setProperty('V45_PHASE','CREATE');}
   Logger.log(JSON.stringify({phase:'DELETE',remainingOldTabs:remain,next:remain?'Run resetV45Master again':'Now run resetV45Master to create new tabs'}));return;
 }
 if(phase==='CREATE'){
   const names=Object.keys(E45.headers),missing=names.filter(n=>!ss.getSheetByName(n));missing.slice(0,2).forEach(name=>e45CreateTab_(ss,name));SpreadsheetApp.flush();
   const remaining=names.filter(n=>!ss.getSheetByName(n));if(remaining.length){Logger.log(JSON.stringify({phase:'CREATE',createdThisRun:Math.min(2,missing.length),remainingTabs:remaining.length}));return;}
   if(work&&ss.getSheets().length>1)ss.deleteSheet(work);p.deleteProperty('V45_PHASE');p.deleteProperty('V45_RESET_CONFIRM');e45FinishLayout_(ss);Logger.log('V4.5 RESET COMPLETE. Same spreadsheet ID: '+ss.getId()+'. No Gmail or pricing triggers installed.');return;
 }
 throw Error('Unknown V45_PHASE '+phase);
}
function e45CreateTab_(ss,name){const sh=ss.insertSheet(name);const h=E45.headers[name],n=h.length;sh.getRange(1,1,1,n).setValues([h]);sh.getRange(1,1,1,n).setBackground(['Price History','Estimate'].includes(name)?'#0B6D75':'#17324D').setFontColor('#FFFFFF').setFontWeight('bold').setWrap(true).setVerticalAlignment('middle');sh.setRowHeight(1,34);sh.setFrozenRows(1);sh.setColumnWidths(1,n,150);if(n>=3)sh.setColumnWidth(3,235);if(['Source Ledger','Run Log','Settings','Label Rules'].includes(name))sh.setTabColor('#8293A2');else sh.setTabColor(['Price History','Estimate'].includes(name)?'#0B6D75':'#3A7A9B');
 if(name==='Settings')sh.getRange(2,1,E45_DEFAULTS.length,3).setValues(E45_DEFAULTS);
 if(name==='Cost Codes')sh.getRange(2,1,E45.costCodes.length,3).setValues(E45.costCodes.map(r=>[r[0],r[1],e45DefaultAlias_(r[1])]));
 if(name==='Documents'){sh.setColumnWidth(24,195);sh.getRange('X:X').setWrapStrategy(SpreadsheetApp.WrapStrategy.CLIP);sh.setColumnWidth(23,275);sh.setColumnWidth(25,290);}
 if(name==='Cost Lines'){sh.setColumnWidth(5,220);sh.setColumnWidth(6,290);sh.setColumnWidth(18,340);}
 if(name==='Scope Notes'){sh.setColumnWidth(3,350);sh.setColumnWidth(7,340);}
 if(name==='Price History'){sh.setColumnWidth(3,230);sh.setColumnWidth(17,310);}
 if(name==='Estimate'){sh.setColumnWidth(3,270);sh.setColumnWidth(14,360);}
 if(name==='Review Queue'){sh.setColumnWidth(4,390);sh.setColumnWidth(5,320);}
 if(name==='Label Rules'){sh.setColumnWidth(1,280);sh.setColumnWidth(5,360);}
 if(name==='Projects'){sh.setColumnWidth(2,270);sh.setColumnWidth(3,275);sh.setColumnWidth(4,350);}
 if(name==='Settings'){sh.setColumnWidth(1,225);sh.setColumnWidth(2,280);sh.setColumnWidth(3,510);}
}
function e45DefaultAlias_(code){const c=String(code).toLowerCase();if(c.includes('deck materials'))return 'pvc decking; composite decking; deck lumber; decking';if(c.includes('deck labor'))return 'deck construction labor; deck framing labor';if(c.includes('excavation'))return 'earthwork; grading; excavation';if(c.includes('concrete'))return 'concrete flatwork; slab; footings';if(c.includes('framing materials'))return 'framing lumber; studs; joists';if(c.includes('framing labor'))return 'framing labor';return '';}
function e45FinishLayout_(ss){const est=ss.getSheetByName('Estimate'),codes=ss.getSheetByName('Cost Codes');est.getRange('B2:B300').setDataValidation(SpreadsheetApp.newDataValidation().requireValueInRange(codes.getRange(2,2,E45.costCodes.length,1),true).build());est.getRange('D2:D300').setDataValidation(SpreadsheetApp.newDataValidation().requireValueInList(['Material','Labor','Subcontractor','Equipment','Mixed'],true).build());est.getRange('H2:M300').setNumberFormat('$#,##0.00');est.getRange('I2:I300').setBackground('#FFF4D6');est.getRange('A2:G300').setBackground('#F6F9FC');const rules=ss.getSheetByName('Label Rules');rules.getRange('B2:B1000').setDataValidation(SpreadsheetApp.newDataValidation().requireValueInList(['Project','Candidate','Ignore'],true).build());rules.getRange('D2:D1000').setDataValidation(SpreadsheetApp.newDataValidation().requireValueInList(['YES','NO'],true).build());
 ['Label Rules','Settings','Source Ledger','Run Log'].forEach(n=>{const sh=ss.getSheetByName(n);if(sh&&!sh.isSheetHidden())sh.hideSheet();});}
function v45MasterStatus(){const ss=e45Book_(),present=ss.getSheets().map(x=>x.getName()),missing=Object.keys(E45.headers).filter(k=>!present.includes(k)),result={phase:PropertiesService.getScriptProperties().getProperty('V45_PHASE')||'COMPLETE',spreadsheetID:ss.getId(),present:present.length,missing,documents:!missing.length?e45Rows_(ss,'Documents').rows.length:null};Logger.log(JSON.stringify(result));return result;}

// ---------- Lightweight estimating: one selectable historical unit rate + manual override ----------
function refreshEstimateV45(){const ss=e45Book_(),view=e45Rows_(ss,'Estimate'),rates=e45Rows_(ss,'Price History').rows,settings=e45Settings_(ss);if(view.sh.getLastRow()<2)return;const out=[];
 for(const line of view.rows){if(!line.Cost_Code&&!line.Rate_Key&&!line.Description&&!line.Qty)continue;const code=String(line.Cost_Code||''),unit=e45Unit_(line.Unit),type=String(line.Cost_Type||''),chosenID=String(line.Rate_Key||'').trim();let pool=rates.filter(x=>String(x.Cost_Code)===code&&e45Unit_(x.Unit)===unit&&x.Cost_Type===type);let selected=chosenID?pool.find(x=>String(x.Rate_Key)===chosenID):null;let message='';
   if(!selected&&!chosenID&&pool.length===1)selected=pool[0];if(!selected)message=pool.length>1?'Multiple rates — select Rate_Key':'No matching historical rate';
   const suggested=selected?e45Num_(selected.Recommended):null,manual=e45Num_(line.Override_Unit_Cost),use=manual!==null?manual:selected&&String(selected.Auto_Use)==='YES'?suggested:null,qty=e45Num_(line.Qty),markup=e45Num_(line.Markup_Pct),pct=markup!==null?markup:e45Num_(settings.DEFAULT_MARKUP_PCT)||0,builder=use!==null&&qty>0?use*qty*(1+(e45Num_(settings.DEFAULT_WASTE_PCT)||0)/100)*(1+(e45Num_(settings.DEFAULT_CONTINGENCY_PCT)||0)/100):null,total=builder!==null?builder*(1+pct/100):null;
   if(selected)message=String(selected.Auto_Use)==='YES'?'Historical rate — '+selected.Samples+' sources':'PROVISIONAL — '+selected.Samples+' source(s); enter override to use';
   out.push({row:line._row,suggested,used:use,builder,total,evidence:message+(selected?' | '+selected.Rate_Key:'')});
 }
 for(const x of out){const sh=view.sh;sh.getRange(x.row,8).setValue(x.suggested===null?'':e45Round_(x.suggested));sh.getRange(x.row,10,1,2).setValues([[x.used===null?'':e45Round_(x.used),x.builder===null?'':e45Round_(x.builder)]]);sh.getRange(x.row,13,1,2).setValues([[x.total===null?'':e45Round_(x.total),x.evidence]]);}
 Logger.log('Estimate lines refreshed: '+out.length);return out.length;}
function onEdit(e){try{if(e&&e.range&&e.range.getSheet().getName()==='Estimate'&&e.range.getRow()>1)refreshEstimateV45();}catch(err){Logger.log('Estimate update: '+err.message);}}
function onOpen(){try{SpreadsheetApp.getUi().createMenu('Cost Intelligence v4.5').addItem('Refresh estimate prices','refreshEstimateV45').addItem('Check system status','v45MasterStatus').addItem('Export Buildertrend Excel','exportBuildertrendV45').addToUi();}catch(e){Logger.log(e.message);}}

// Optional values-only 27-column Excel export for Buildertrend's import-mapping workflow.
const E45_BT_FIELDS=['Category','Cost Code','Title','Parent Group','Parent Group Description','Subgroup','Subgroup Description','Option Type','Line Item Type','Description','Quantity','Unit','Unit Cost','Cost Type','Marked As','Builder Cost','Markup','Markup Type','Unit Price','Client Price','Margin','Profit','Taxable','Tax Amount','Total Price','% Invoiced','Internal Notes'];
function exportBuildertrendV45(){refreshEstimateV45();const ss=e45Book_(),rows=e45Rows_(ss,'Estimate').rows,cat=new Map(e45Rows_(ss,'Cost Codes').rows.map(x=>[x.Cost_Code,x.Category]));const list=[];
 rows.filter(x=>x.Qty||x.Cost_Code).forEach(x=>{const qty=e45Num_(x.Qty),cost=e45Num_(x.Used_Unit_Cost),builder=e45Num_(x.Builder_Cost),total=e45Num_(x.Client_Total);if(!(qty>0)||cost===null||!cat.has(x.Cost_Code)||total===null)throw Error('Incomplete estimate row '+x._row+'. Need code, quantity and approved/override rate.');const markup=e45Num_(x.Markup_Pct)||0,profit=total-builder;list.push([cat.get(x.Cost_Code),x.Cost_Code,x.Description,'','','','','','Standard',x.Evidence,qty,x.Unit,builder/qty,x.Cost_Type,'',builder,markup,'Percent',total/qty,total,total?profit/total*100:0,profit,'No',0,total,0,'Source rate: '+x.Rate_Key]);});
 if(!list.length)throw Error('No completed estimate lines');const file=SpreadsheetApp.create('CCI v4.5 Buildertrend Temporary'),sh=file.getSheets()[0];sh.setName('Estimate');sh.getRange(1,1,1,E45_BT_FIELDS.length).setValues([E45_BT_FIELDS]);sh.getRange(2,1,list.length,E45_BT_FIELDS.length).setValues(list);SpreadsheetApp.flush();const response=UrlFetchApp.fetch('https://docs.google.com/spreadsheets/d/'+file.getId()+'/export?format=xlsx',{headers:{Authorization:'Bearer '+ScriptApp.getOAuthToken()},muteHttpExceptions:true});if(response.getResponseCode()!==200)throw Error('Excel export HTTP '+response.getResponseCode());const output=DriveApp.createFile(response.getBlob().setName('Buildertrend_Estimate_v45.xlsx'));DriveApp.getFileById(file.getId()).setTrashed(true);Logger.log('Review import column mapping in Buildertrend: '+output.getUrl());return output.getUrl();}

function removeOldPersonalTriggersV45(){const old=['dailyHistoricalRefreshV4','refreshHistoricalRatesV32','refreshRateLibraryV4','dailyHistoricalRefreshV4'];ScriptApp.getProjectTriggers().forEach(t=>{if(old.includes(t.getHandlerFunction()))ScriptApp.deleteTrigger(t);});Logger.log('Old personal pricing triggers removed. v4.5 pricing is rebuilt by billing after ingestion.');}
